DJANGO_SECRET_KEY=generate-a-long-random-secret-and-store-it-only-in-environment
DJANGO_DEBUG=False
DJANGO_DATABASE=mongodb
DJANGO_ALLOWED_HOSTS=your-connectly-service.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-connectly-service.onrender.com
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/connectly?retryWrites=true&w=majority
MONGODB_DATABASE=connectly
